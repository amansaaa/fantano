# read by docker compose, the pipeline, and (via symlink) the web app.

# MySQL — docker compose creates this database and user on first start
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=fantano
MYSQL_USER=fantano
MYSQL_PASSWORD=change-me
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# YouTube Data API v3 key (Google Cloud Console → APIs & Services → Credentials)
YOUTUBE_API_KEY=

# Gemini API key + model name
GEMINI_API_KEY=
GEMINI_MODEL=

# MusicBrainz requires a User-Agent with contact info (your email or the repo url). load.py refuses to run with the placeholder
MUSICBRAINZ_CONTACT=you@example.com
