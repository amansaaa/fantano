# Copy to .env — read by docker compose, the pipeline, and (via symlink) the web app.
#   cp .env.example .env && ln -s ../.env web/.env.local
# Never commit .env.

# MySQL — docker compose creates this database and user on first start
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=fantano
MYSQL_USER=fantano
MYSQL_PASSWORD=change-me
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# YouTube Data API v3 key (Google Cloud Console → APIs & Services → Credentials)
YOUTUBE_API_KEY=

# Gemini API key + model name (Google AI Studio; pick a free-tier model with enough daily requests)
GEMINI_API_KEY=
GEMINI_MODEL=

# MusicBrainz requires a User-Agent with contact info
MUSICBRAINZ_CONTACT=you@example.com
